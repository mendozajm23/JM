rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNumber(val) {
      return val is int || val is float;
    }

    function isNonNegNumber(val) {
      return isNumber(val) && val >= 0;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidEmployeeProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 80 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 60 &&
             data.employeeCode is string && data.employeeCode.size() >= 1 && data.employeeCode.size() <= 30 &&
             isNonNegNumber(data.monthlyBaseSalary) && data.monthlyBaseSalary <= 100000000 &&
             data.payFrequency in ['quincenal', 'mensual'] &&
             isNumber(data.dailyWorkHours) && data.dailyWorkHours > 0 && data.dailyWorkHours <= 24 &&
             isNumber(data.overtimeMultiplier) && data.overtimeMultiplier >= 1.0 && data.overtimeMultiplier <= 4.0 &&
             data.isSelf is bool &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAttendanceLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.employeeId) &&
             data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 100 &&
             data.workDate is string && data.workDate.size() == 10 && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.clockInMillis is int && data.clockInMillis > 0 &&
             data.clockOutMillis is int && (data.clockOutMillis == 0 || data.clockOutMillis >= data.clockInMillis) &&
             data.modality in ['presencial', 'remoto', 'campo'] &&
             data.status in ['abierto', 'completado', 'tardanza', 'incompleto'] &&
             isNonNegNumber(data.regularHours) && data.regularHours <= 24 &&
             isNonNegNumber(data.overtimeHours) && data.overtimeHours <= 24 &&
             data.notes is string && data.notes.size() <= 300 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPayrollRecord(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.employeeId) &&
             data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 100 &&
             data.periodType in ['quincenal', 'mensual'] &&
             data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 60 &&
             isNonNegNumber(data.baseSalaryPeriod) &&
             isNonNegNumber(data.overtimeHours) && data.overtimeHours <= 500 &&
             isNonNegNumber(data.overtimePay) &&
             isNonNegNumber(data.bonuses) &&
             isNonNegNumber(data.grossPay) &&
             isNonNegNumber(data.inssEmployee) &&
             isNonNegNumber(data.taxableBasePeriod) &&
             isNonNegNumber(data.projectedAnnualIncome) &&
             data.irBracketLabel is string && data.irBracketLabel.size() >= 1 && data.irBracketLabel.size() <= 60 &&
             isNonNegNumber(data.irPeriod) &&
             isNonNegNumber(data.otherDeductions) &&
             isNonNegNumber(data.netPay) &&
             data.status in ['borrador', 'pagado'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---
    match /users/{userId} {

      // 1. Employee Profiles
      match /employees/{employeeId} {
        allow get: if isOwner(userId) && isValidId(employeeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(employeeId) &&
                         incoming().keys().hasAll([
                           'userId', 'fullName', 'roleTitle', 'department', 'employeeCode',
                           'monthlyBaseSalary', 'payFrequency', 'dailyWorkHours',
                           'overtimeMultiplier', 'isSelf', 'active', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'fullName', 'roleTitle', 'department', 'employeeCode',
                           'monthlyBaseSalary', 'payFrequency', 'dailyWorkHours',
                           'overtimeMultiplier', 'isSelf', 'active', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidEmployeeProfile(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(employeeId) &&
                         isValidEmployeeProfile(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'fullName', 'roleTitle', 'department', 'employeeCode',
                           'monthlyBaseSalary', 'payFrequency', 'dailyWorkHours',
                           'overtimeMultiplier', 'active', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(employeeId);
      }

      // 2. Attendance Logs (Marcaciones Entrada/Salida)
      match /attendance_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll([
                           'userId', 'employeeId', 'employeeName', 'workDate',
                           'clockInMillis', 'clockOutMillis', 'modality', 'status',
                           'regularHours', 'overtimeHours', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'employeeId', 'employeeName', 'workDate',
                           'clockInMillis', 'clockOutMillis', 'modality', 'status',
                           'regularHours', 'overtimeHours', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidAttendanceLog(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/employees/$(incoming().employeeId));

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidAttendanceLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().employeeId == existing().employeeId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Clock Out or Adjust Shift
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'clockOutMillis', 'status', 'regularHours', 'overtimeHours',
                             'modality', 'notes', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // 3. Payroll Records (Nómina Quincenal/Mensual)
      match /payrolls/{payrollId} {
        allow get: if isOwner(userId) && isValidId(payrollId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(payrollId) &&
                         incoming().keys().hasAll([
                           'userId', 'employeeId', 'employeeName', 'periodType', 'periodLabel',
                           'baseSalaryPeriod', 'overtimeHours', 'overtimePay', 'bonuses',
                           'grossPay', 'inssEmployee', 'taxableBasePeriod', 'projectedAnnualIncome',
                           'irBracketLabel', 'irPeriod', 'otherDeductions', 'netPay',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'employeeId', 'employeeName', 'periodType', 'periodLabel',
                           'baseSalaryPeriod', 'overtimeHours', 'overtimePay', 'bonuses',
                           'grossPay', 'inssEmployee', 'taxableBasePeriod', 'projectedAnnualIncome',
                           'irBracketLabel', 'irPeriod', 'otherDeductions', 'netPay',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidPayrollRecord(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/employees/$(incoming().employeeId));

        allow update: if isOwner(userId) &&
                         isValidId(payrollId) &&
                         isValidPayrollRecord(incoming(), userId) &&
                         existing().status != 'pagado' &&
                         incoming().userId == existing().userId &&
                         incoming().employeeId == existing().employeeId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'periodLabel', 'overtimeHours', 'overtimePay', 'bonuses',
                           'grossPay', 'inssEmployee', 'taxableBasePeriod', 'projectedAnnualIncome',
                           'irBracketLabel', 'irPeriod', 'otherDeductions', 'netPay',
                           'status', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(payrollId);
      }
    }
  }
}
